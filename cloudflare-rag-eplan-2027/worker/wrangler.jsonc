{
  "name": "eplan-wiki-2027",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-23",
  "compatibility_flags": ["nodejs_compat"],

  // D1 (SQLite + FTS5) -- full-text/keyword search over the 2027 API wiki
  // (eplan_wiki_scraper.py output: classes/categories bundled per-file,
  // members inlined). Separate database and separate Worker from
  // rag2026.covaga.xyz on purpose: different doc version (2027 vs 2026),
  // different search mode (keyword/FTS5 here vs semantic/bge+Vectorize
  // there) -- complementary, not a replacement.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eplan-wiki-2027",
      "database_id": "632a6de2-d0f2-498c-921e-cb1e77b040aa"
    }
  ],

  // Custom domain
  "routes": [
    {
      "pattern": "rag2027.covaga.xyz",
      "custom_domain": true
    }
  ]
}
